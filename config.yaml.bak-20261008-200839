default_permission_matcher: bypass_plus
defaults:
    full: codex-gpt-6-luna(medium)
    mini: codex-gpt-6-luna(medium)
integrations:
    search:
        providers:
            brave:
                enabled: true
                key: ${BRAVE_API_KEY}
            exa:
                enabled: true
                key: ${EXA_API_KEY}
            kagi:
                enabled: true
                key: ${KAGI_API_KEY}
            tavily:
                enabled: true
                key: ${TAVILY_API_KEY}
        strategy: round_robin
mcp_servers:
    komodo:
        args:
            - /home/wbw/.local/bin/komodo-mcp
        command: sh
        pass_env:
            - HOME
            - PATH
            - LANG
            - TMPDIR
        transport: stdio
models:
    codex-gpt-6-astra:
        class: full
        context_window: 128000
        enabled: true
        max_output_tokens_per_turn: 16384
        max_tokens: 16384
        provider: codex
        provider_name: gpt-6-astra
        variant: openai
