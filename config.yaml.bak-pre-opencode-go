version: 2
default_permission_matcher: bypass_plus
defaults:
  full: codex-gpt-6-luna(medium)
  mini: codex-gpt-6-luna(medium)
providers:
  zai:
    kind:
      type: catalog
      name: zai
    auth:
      type: static_key
      key: ${ZAI_API_KEY}
  neuralwatt:
    kind:
      type: catalog
      name: neuralwatt
    auth:
      type: static_key
      key: ${NEURALWATT_API_KEY}
  codex:
    kind:
      type: catalog
      name: codex
    auth:
      type: codex_device
      profile: default
  opencode-go-chat:
    kind:
      type: custom_open_ai_compatible
    url: https://opencode.ai/zen/go/v1
    protocol: openai_chat_completions
    auth:
      type: static_key
      key: ${OPENCODE_API_KEY}
  opencode-zen-systemone:
    kind:
      type: custom_open_ai_compatible
    url: https://opencode.ai/zen/v1/systemone
    protocol: openai_chat_completions
    auth:
      type: static_key
      key: ${OPENCODE_API_KEY}

models:
  codex-gpt-6-astra:
    provider: codex
    provider_name: gpt-6-astra
    variant: openai
    class: full
    context_window: 128000
    max_tokens: 16384
    max_output_tokens_per_turn: 16384
  codex-gpt-6-sol:
    provider: codex
    provider_name: gpt-6-sol
    variant: openai
    class: full
    context_window: 128000
    max_tokens: 16384
